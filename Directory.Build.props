<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.2.0</Version>
    <Company>KORTY</Company>
    <Product>KORTY Keyboard Studio</Product>
    <!-- Security audit: no pre/post-build commands, no downloaded executables, no package scripts. -->
  </PropertyGroup>
</Project>

