<UserControl x:Class="Korty.App.Views.SafetyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" BorderBrush="{Binding VerdictBrush}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding ToggleText}" Command="{Binding ToggleControlCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Verdict}" FontSize="19" FontWeight="SemiBold" Foreground="{Binding VerdictBrush}"/>
                            <TextBlock Text="{Binding Explain}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Как защищена клавиатура" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Checklist}" Style="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="20"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Навсегда заблокированы: сброс и заводской сброс, перепрошивка, переназначение клавиш, макросы, частота опроса, любые неизвестные команды."/>
                </StackPanel>
            </Border>

            <CheckBox Content="Показать дополнительные настройки" IsChecked="{Binding ShowAdvanced}" Margin="2,16,0,8"/>

            <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource B2V}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Этапы разрешений" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding RegistryText}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Info.Title}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" Margin="0,2,0,6" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Info.Allows}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding ActionCommand}" VerticalAlignment="Top" Margin="14,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="ПАРАМЕТРЫ ПРОТОКОЛА (по умолчанию — как в эталоне)" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                        <WrapPanel>
                            <CheckBox Content="SAVE: byte 8 = 0x01 (по умолчанию 0x00)" IsChecked="{Binding SaveFlag}" Margin="0,0,24,6"/>
                            <CheckBox Content="FINISH после подсветки" IsChecked="{Binding FinishAfterLighting}" Margin="0,0,24,6"/>
                            <CheckBox Content="вариант картинки gohv" IsChecked="{Binding GohvImage}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Менять только если подсветка или экран не применяются — эталонный конфигуратор предлагает те же переключатели."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Режим работы" Style="{StaticResource H2}"/>
                        <CheckBox Content="Режим симуляции (клавиатура не используется — для проверки интерфейса)" IsChecked="{Binding Simulation}" Margin="0,12,0,0"/>
                        <TextBlock Text="СЕМЕЙСТВО ПРОТОКОЛА" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
                        <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding Family, Mode=TwoWay}" Width="220" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Для AK820 Pro по USB выбирается автоматически (Feature04). Менять не нужно."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                            <TextBlock Text="Каталог известных команд" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Всё, чего нет в списке, не отправляется. Красным — заблокировано навсегда."/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Catalog}" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="СЕМЕЙСТВО" Binding="{Binding Family}" Width="100"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="56"/>
                                <DataGridTextColumn Header="КОМАНДА" Binding="{Binding Name}" Width="210"/>
                                <DataGridTextColumn Header="РИСК" Binding="{Binding Risk}" Width="120">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Brush}"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="ИСТОЧНИК" Binding="{Binding Source}" Width="150"/>
                                <DataGridTextColumn Header="ПРИМЕЧАНИЕ" Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
