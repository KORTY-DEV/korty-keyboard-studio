<UserControl x:Class="Korty.App.Views.KeyboardSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Visibility="{Binding ShowEnable, Converter={StaticResource B2V}}" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Включить управление клавиатурой" Command="{Binding EnableControlCommand}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" Text="Чтобы менять настройки клавиатуры, включите управление (одно подтверждение)." VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Время отклика клавиш" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,10" Text="Задержка защиты от дребезга контактов: чем ниже уровень, тем быстрее реакция, чем выше — тем надёжнее от двойных нажатий. Значения в мс — из фирменной программы."/>
                    <ItemsControl ItemsSource="{Binding Levels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Choose}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,6" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="✔ выбрано" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding Selected, Converter={StaticResource B2V}}"/>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Wired}" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding Wireless}" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding Bluetooth}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LevelNote}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Сон после бездействия" Style="{StaticResource H2}"/>
                    <ComboBox ItemsSource="{Binding SleepNames}" SelectedIndex="{Binding SleepLevel, Mode=TwoWay}" Width="180" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Отключение клавиш" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,10" Text="Настройка хранится в самой клавиатуре и действует без запущенной программы — удобно в играх."/>
                    <CheckBox Content="Отключить клавишу Windows" IsChecked="{Binding DisableWin}" Margin="0,0,0,8"/>
                    <CheckBox Content="Отключить Alt + F4" IsChecked="{Binding DisableAltF4}" Margin="0,0,0,8"/>
                    <CheckBox Content="Отключить Alt + Tab" IsChecked="{Binding DisableAltTab}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,10" Text="Формат команды восстановлен из фирменной программы и на реальной клавиатуре ещё не проверялся. Для первой проверки установите те же значения, что сейчас в фирменной программе (по умолчанию: уровень 3, сон 5 минут, клавиши не отключены)."/>
                    <Button Content="Применить к клавиатуре" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Block}" Foreground="{StaticResource WarnBrush}" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding HasBlock, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Сброс клавиатуры и заводской сброс" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="Намеренно заблокированы в KORTY: действие необратимо стирает настройки. Используйте фирменную программу или аппаратную комбинацию клавиатуры (см. её инструкцию)."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
