<Window x:Class="Korty.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Korty.App.ViewModels"
        xmlns:v="clr-namespace:Korty.App.Views"
        Title="KORTY Keyboard Studio · AJAZZ AK820 Pro" Width="1360" Height="880" MinWidth="1120" MinHeight="720"
        Icon="Assets/korty.ico" Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScreenEditorViewModel}"><v:ScreenEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RgbViewModel}"><v:RgbView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><v:ProfilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><v:DiagnosticsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimulatorViewModel}"><v:SimulatorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SafetyViewModel}"><v:SafetyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeyboardSettingsViewModel}"><v:KeyboardSettingsView/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,22">
                    <TextBlock Text="KORTY" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="KEYBOARD STUDIO" Style="{StaticResource Caption}" Margin="1,-2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,10,8,0">
                    <Border Style="{StaticResource Pill}" BorderBrush="{Binding ModeBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ModeBadge}" Foreground="{Binding ModeBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="v1.2 · без телеметрии · офлайн" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected, Mode=TwoWay}" Focusable="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,5">
                                <TextBlock Text="{Binding Glyph}" Width="26" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28,22,28,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Connection}" FontSize="12.5"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding Page}" Focusable="False"/>
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="2,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
